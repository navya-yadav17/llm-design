# LLM calls are disabled unless explicitly enabled.
DIAGNOSTICS_LLM_ENABLED=false

# OpenAI-compatible chat completions endpoint; use a trusted provider or local gateway.
DIAGNOSTICS_LLM_BASE_URL=
DIAGNOSTICS_LLM_MODEL=
DIAGNOSTICS_LLM_API_KEY=

# Required before the analysis endpoint accepts requests. Keep this value private.
DIAGNOSTICS_API_KEY=

# Per-client process-local sliding-window limit.
DIAGNOSTICS_RATE_LIMIT=60
DIAGNOSTICS_RATE_WINDOW_SECONDS=60
